{
  "entities": {
    "AssessmentRecord": {
      "title": "AssessmentRecord",
      "description": "Private full assessment record stored under a user's personal history",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the candidate",
          "maxLength": 128
        },
        "scholarName": {
          "type": "string",
          "description": "Candidate's declared scholar name",
          "minLength": 1,
          "maxLength": 40
        },
        "modeName": {
          "type": "string",
          "description": "Assessment scope/mode label",
          "maxLength": 40
        },
        "polymathQuotient": {
          "type": "number",
          "description": "Primary Polymath Quotient (PQ) score"
        },
        "accuracyPercentage": {
          "type": "number",
          "description": "Percentage of correct answers (0 to 100)"
        },
        "confidenceScore": {
          "type": "number",
          "description": "Polymath confidence score (0 to 100)"
        },
        "breadthIndex": {
          "type": "number",
          "description": "Uniformity / balance index across tested domains (0 to 100)"
        },
        "archetypeName": {
          "type": "string",
          "description": "Short archetype tier level",
          "maxLength": 100
        },
        "archetypeTitle": {
          "type": "string",
          "description": "Full archetype title",
          "maxLength": 100
        },
        "correctCount": {
          "type": "number",
          "description": "Total correct answers"
        },
        "totalCount": {
          "type": "number",
          "description": "Total questions in the assessment"
        },
        "durationSeconds": {
          "type": "number",
          "description": "Total deliberation duration in seconds"
        },
        "domainScores": {
          "type": "object",
          "description": "Map of discipline ID to accuracy percentage"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of completion"
        }
      },
      "required": [
        "userId",
        "scholarName",
        "modeName",
        "polymathQuotient",
        "accuracyPercentage",
        "confidenceScore",
        "breadthIndex",
        "archetypeName",
        "archetypeTitle",
        "correctCount",
        "totalCount",
        "durationSeconds",
        "domainScores",
        "createdAt"
      ]
    },
    "CommunityScore": {
      "title": "CommunityScore",
      "description": "Public zero-PII scoreboard entry for the community feed",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase UID",
          "maxLength": 128
        },
        "scholarName": {
          "type": "string",
          "description": "Public scholar display name (1-40 chars)",
          "minLength": 1,
          "maxLength": 40
        },
        "polymathQuotient": {
          "type": "number",
          "description": "Calculated Polymath Quotient"
        },
        "accuracyPercentage": {
          "type": "number",
          "description": "Percentage score earned (0 to 100)"
        },
        "archetypeTitle": {
          "type": "string",
          "description": "Earned Polymath archetype title",
          "maxLength": 100
        },
        "modeName": {
          "type": "string",
          "description": "Assessment scope/mode label",
          "maxLength": 40
        },
        "isPublic": {
          "type": "boolean",
          "description": "Must be true for community visibility"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when saved to cloud"
        }
      },
      "required": [
        "userId",
        "scholarName",
        "polymathQuotient",
        "accuracyPercentage",
        "archetypeTitle",
        "modeName",
        "isPublic",
        "createdAt"
      ]
    },
    "CommunityStats": {
      "title": "CommunityStats",
      "description": "Atomic global community aggregate for real-time PQ and accuracy averages",
      "type": "object",
      "properties": {
        "totalAttempts": {
          "type": "number",
          "description": "Total saved cloud attempts across all scholars"
        },
        "totalPqSum": {
          "type": "number",
          "description": "Cumulative sum of Polymath Quotient scores"
        },
        "totalAccuracySum": {
          "type": "number",
          "description": "Cumulative sum of accuracy percentages"
        },
        "highestPq": {
          "type": "number",
          "description": "Highest Polymath Quotient recorded in community"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last aggregate update"
        }
      },
      "required": [
        "totalAttempts",
        "totalPqSum",
        "totalAccuracySum",
        "highestPq",
        "updatedAt"
      ]
    },
    "QuestionStats": {
      "title": "QuestionStats",
      "description": "Empirical accuracy and deliberation statistics for an individual question",
      "type": "object",
      "properties": {
        "questionId": {
          "type": "string",
          "description": "Unique identifier of the question",
          "maxLength": 64
        },
        "attemptCount": {
          "type": "number",
          "description": "Number of times this question was answered"
        },
        "correctCount": {
          "type": "number",
          "description": "Number of times answered correctly"
        },
        "successRate": {
          "type": "number",
          "description": "Empirical percentage of candidates answering correctly (0 to 100)"
        },
        "totalTimeSpentSec": {
          "type": "number",
          "description": "Cumulative seconds spent by candidates on this question"
        },
        "avgTimeSpentSec": {
          "type": "number",
          "description": "Average seconds spent deliberating on this question"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update"
        }
      },
      "required": ["questionId", "attemptCount", "correctCount", "successRate", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/assessments/{recordId}": {
      "schema": { "$ref": "#/entities/AssessmentRecord" },
      "description": "Private owner-only full assessment history with per-domain breakdowns"
    },
    "/community_scores/{scoreId}": {
      "schema": { "$ref": "#/entities/CommunityScore" },
      "description": "Public zero-PII scoreboard entries for community comparison"
    },
    "/community_stats/global": {
      "schema": { "$ref": "#/entities/CommunityStats" },
      "description": "Singleton aggregate document storing global community PQ and accuracy sums"
    },
    "/question_stats/{questionId}": {
      "schema": { "$ref": "#/entities/QuestionStats" },
      "description": "Aggregated statistical performance and empirical difficulty per question"
    }
  }
}
